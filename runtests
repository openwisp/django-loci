#!/usr/bin/env python
"""Run the CI suite or selected Django and Channels tests."""

import os
import re
import subprocess
import sys
from importlib import import_module
from unittest import TestCase


def main():
    if len(sys.argv) == 1:
        for arguments in (
            ["coverage", "erase"],
            [
                "coverage",
                "run",
                "runtests.py",
                "--parallel",
                "--exclude-tag=selenium_tests",
            ],
            [
                "coverage",
                "run",
                "runtests.py",
                "--tag=selenium_tests",
                "--exclude-pytest",
            ],
            ["coverage", "combine"],
            ["coverage", "xml"],
        ):
            result = subprocess.run(arguments)
            if result.returncode:
                return result.returncode
        return 0

    if sys.argv[1] == "django_loci/tests/pytest_channels.py":
        if any(argument not in ("-q", "-v") for argument in sys.argv[2:]):
            print("Unsupported test argument", file=sys.stderr)
            return 2
        sys.path.insert(0, "tests")
        os.environ["DJANGO_SETTINGS_MODULE"] = "openwisp2.settings"
        import django
        import pytest

        django.setup()
        # The project's addopts include the entire test directory.
        return pytest.main(
            ["-o", "addopts=--create-db --reuse-db --nomigrations", *sys.argv[1:]]
        )

    # Restrict names to actual test modules and TestCase classes.
    pattern = re.compile(
        r"(?P<module>django_loci\.tests\.(?:test_\w+|testdeviceapp\.tests\.test_\w+))"
        r"(?:\.(?P<class>[A-Z]\w*)(?:\.test_\w+)?)?"
    )
    labels = []
    flags = []
    for argument in sys.argv[1:]:
        if argument in ("--failfast", "--noinput"):
            flags.append(argument)
            continue
        match = pattern.fullmatch(argument)
        if not match:
            print(f"Unsupported test argument: {argument}", file=sys.stderr)
            return 2
        labels.append(match)
    if not labels:
        print("Unsupported test arguments: a test label is required", file=sys.stderr)
        return 2
    sys.path.insert(0, "tests")
    os.environ["DJANGO_SETTINGS_MODULE"] = "openwisp2.settings"
    import django

    django.setup()
    for match in labels:
        if match.group("class"):
            module = import_module(match.group("module"))
            candidate = getattr(module, match.group("class"), None)
            if not isinstance(candidate, type) or not issubclass(candidate, TestCase):
                print(f"Unsupported test argument: {match.group(0)}", file=sys.stderr)
                return 2
    from django.core.management import execute_from_command_line

    execute_from_command_line(
        [sys.argv[0], "test", *[m.group(0) for m in labels], *flags]
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
